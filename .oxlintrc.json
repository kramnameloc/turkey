{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error" },
  "env": { "browser": true },
  "rules": {
    "eslint/no-undef": "error",
    "eslint/no-new-func": "error",
    "eslint/no-implied-eval": "error"
  },
  "overrides": [
    {
      "files": ["*.config.js", "scripts/**/*.mjs", "test/**/*.js", "e2e/**/*.js"],
      "env": { "node": true }
    }
  ]
}
