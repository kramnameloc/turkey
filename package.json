{
  "name": "flappy-turkey",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:pages": "npm run build && node scripts/check-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "play:lan": "vite preview --host 0.0.0.0",
    "lint": "oxlint",
    "test": "node --test",
    "test:exporters": "python3 -m unittest discover -s test/exporters",
    "browsers:install": "playwright install --no-shell chromium webkit",
    "test:e2e": "npm run build:pages && npm run test:e2e:built --",
    "test:e2e:built": "playwright test",
    "check:quick": "npm run lint && npm test && npm run test:exporters && npm run build:pages",
    "check": "npm run check:quick && npm run test:e2e:built"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lit-html": "^3.3.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.95.0",
    "vite": "^8.3.8"
  }
}
